---
import { env } from "cloudflare:workers";
import { PortableText } from "emdash/ui";
import Arrow from "../components/Arrow.astro";
import PageHeader from "../components/PageHeader.astro";
import Base from "../layouts/Base.astro";
import { COMPANY } from "../lib/company";
import { LIMITS } from "../lib/contact";
import { loadPage } from "../lib/page";

const result = await loadPage(Astro, "contact");
const page = result?.page;
const seo = result?.seo;

const turnstileSiteKey = (env as unknown as { TURNSTILE_SITE_KEY?: string }).TURNSTILE_SITE_KEY || "";
const status = Astro.url.searchParams.get("status");
const renderedAt = Date.now();
const mailto = `mailto:info@motenas.co.jp`;

// The form depends on the render timestamp, so never serve it from a cache.
Astro.response.headers.set("Cache-Control", "no-store");
---

<Base
	title={seo?.title ?? "お問い合わせ"}
	pageTitle={page?.data.title ?? "お問い合わせ"}
	description={seo?.description}
	image={seo?.ogImage}
	canonical={seo?.canonical}
	robots={seo?.robots}
	content={page ? { collection: "pages", id: page.data.id, slug: page.id } : undefined}
>
	{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />}

	<PageHeader
		en={["Contact"]}
		title={page?.data.title ?? "お問い合わせ"}
		lead={page?.data.lead}
		titleEdit={page?.edit.title}
		leadEdit={page?.edit.lead}
		breadcrumb={[{ href: "/contact", label: page?.data.title ?? "お問い合わせ" }]}
	/>

	<section class="section container contact">
		<div class="contact__side">
			{
				page?.data.content && page.data.content.length > 0 && (
					<div class="prose contact__notes" {...page.edit.content}>
						<PortableText value={page.data.content} />
					</div>
				)
			}
			<dl class="facts">
				<div class="facts__row">
					<dt class="facts__label">TEL</dt>
					<dd><a href={`tel:${COMPANY.tel.replaceAll("-", "")}`}>{COMPANY.tel}</a></dd>
				</div>
				<div class="facts__row">
					<dt class="facts__label">営業時間</dt>
					<dd>{COMPANY.hours}</dd>
				</div>
			</dl>
		</div>

		<form
			class="contact__form"
			method="post"
			action="/api/contact"
			data-contact-form
			novalidate
		>
			<div
				class="contact__status"
				role="status"
				aria-live="polite"
				data-status
				data-initial={status ?? ""}
			>
				{status === "sent" && <p>送信しました。内容を確認のうえ、担当者よりご連絡いたします。</p>}
				{
					status === "error" && (
						<p>
							送信できませんでした。お手数ですが、時間をおいて再度お試しいただくか、
							<a href={mailto}>info@motenas.co.jp</a> まで直接ご連絡ください。
						</p>
					)
				}
				{status === "invalid" && <p>入力内容をご確認のうえ、もう一度送信してください。</p>}
			</div>

			<div class="field">
				<label class="field__label" for="contact-name">
					お名前 <span class="field__required">必須</span>
				</label>
				<input
					id="contact-name"
					class="input"
					name="name"
					type="text"
					autocomplete="name"
					required
					maxlength={LIMITS.name}
					aria-describedby="contact-name-error"
				/>
				<p class="field__error" id="contact-name-error" data-error-for="name"></p>
			</div>

			<div class="field">
				<label class="field__label" for="contact-email">
					メールアドレス <span class="field__required">必須</span>
				</label>
				<input
					id="contact-email"
					class="input"
					name="email"
					type="email"
					autocomplete="email"
					inputmode="email"
					required
					maxlength={LIMITS.email}
					aria-describedby="contact-email-error"
				/>
				<p class="field__error" id="contact-email-error" data-error-for="email"></p>
			</div>

			<div class="field">
				<label class="field__label" for="contact-subject">題名</label>
				<input
					id="contact-subject"
					class="input"
					name="subject"
					type="text"
					maxlength={LIMITS.subject}
					aria-describedby="contact-subject-error"
				/>
				<p class="field__error" id="contact-subject-error" data-error-for="subject"></p>
			</div>

			<div class="field">
				<label class="field__label" for="contact-message">メッセージ本文</label>
				<textarea
					id="contact-message"
					class="input"
					name="message"
					rows="8"
					maxlength={LIMITS.message}
					aria-describedby="contact-message-error"></textarea>
				<p class="field__error" id="contact-message-error" data-error-for="message"></p>
			</div>

			<!-- Spam traps: humans never see or fill these. -->
			<div class="visually-hidden" aria-hidden="true">
				<label for="contact-website">Website</label>
				<input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
			</div>
			<input type="hidden" name="rendered_at" value={String(renderedAt)} />

			{turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark" />}

			<div class="contact__submit">
				<button type="submit" class="btn" data-submit>
					送信する <Arrow />
				</button>
				<p class="caption muted">確認画面は表示されません</p>
			</div>
		</form>
	</section>
</Base>

<script>
	const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
	const statusBox = document.querySelector<HTMLElement>("[data-status]");
	const submit = document.querySelector<HTMLButtonElement>("[data-submit]");

	const messages: Record<string, string> = {
		name: "お名前を入力してください。",
		email: "メールアドレスを正しく入力してください。",
	};

	function setStatus(html: string) {
		if (statusBox) statusBox.innerHTML = html;
	}

	function showErrors(errors: Record<string, string>) {
		for (const el of document.querySelectorAll<HTMLElement>("[data-error-for]")) {
			const field = el.dataset.errorFor ?? "";
			el.textContent = errors[field] ?? "";
			const input = form?.elements.namedItem(field);
			if (input instanceof HTMLElement) {
				input.setAttribute("aria-invalid", errors[field] ? "true" : "false");
			}
		}
	}

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();

		const errors: Record<string, string> = {};
		for (const name of ["name", "email"]) {
			const input = form.elements.namedItem(name) as HTMLInputElement | null;
			if (input && !input.checkValidity()) errors[name] = messages[name];
		}
		showErrors(errors);
		if (Object.keys(errors).length > 0) {
			(form.querySelector("[aria-invalid='true']") as HTMLElement | null)?.focus();
			return;
		}

		if (submit) submit.disabled = true;
		setStatus("<p>送信しています…</p>");
		try {
			const response = await fetch(form.action, {
				method: "POST",
				body: new FormData(form),
				headers: { Accept: "application/json" },
			});
			const result = (await response.json().catch(() => ({}))) as {
				status?: string;
				message?: string;
				errors?: Record<string, string>;
			};
			if (response.ok && result.status === "sent") {
				form.reset();
				setStatus("<p>送信しました。内容を確認のうえ、担当者よりご連絡いたします。</p>");
				statusBox?.scrollIntoView({ block: "center", behavior: "smooth" });
				return;
			}
			if (result.errors) showErrors(result.errors);
			setStatus(
				`<p>${result.message ?? "送信できませんでした。"} 解決しない場合は <a href="mailto:info@motenas.co.jp">info@motenas.co.jp</a> まで直接ご連絡ください。</p>`,
			);
		} catch {
			setStatus(
				'<p>通信エラーが発生しました。時間をおいて再度お試しいただくか、<a href="mailto:info@motenas.co.jp">info@motenas.co.jp</a> まで直接ご連絡ください。</p>',
			);
		} finally {
			if (submit) submit.disabled = false;
			const turnstile = (window as unknown as { turnstile?: { reset: () => void } }).turnstile;
			turnstile?.reset();
		}
	});
</script>

<style>
	.contact {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
		gap: 48px 64px;
	}

	.contact__side {
		display: grid;
		align-content: start;
		gap: 32px;
	}

	.contact__notes {
		font-size: 14px;
	}

	.contact__form {
		display: grid;
		gap: 28px;
	}

	.contact__status:empty {
		display: none;
	}

	.contact__status {
		padding: 16px 20px;
		border: 1px solid var(--color-frost);
		border-radius: var(--radius-sm);
		line-height: 1.8;
	}

	.contact__status :global(a) {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.field__error {
		min-height: 0;
		font-size: 13px;
		color: var(--color-bone);
	}

	.field__error:empty {
		display: none;
	}

	.field__error::before {
		content: "— ";
	}

	.input[aria-invalid="true"] {
		border-color: var(--color-bone);
		border-width: 2px;
	}

	.contact__submit {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		align-items: center;
	}

	@media (max-width: 860px) {
		.contact {
			grid-template-columns: 1fr;
		}
	}
</style>
