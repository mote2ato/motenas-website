---
import { PortableText } from "emdash/ui";
import Arrow from "../components/Arrow.astro";
import Facts from "../components/Facts.astro";
import PageHeader from "../components/PageHeader.astro";
import Base from "../layouts/Base.astro";
import { COMPANY } from "../lib/company";
import { loadPage } from "../lib/page";

const result = await loadPage(Astro, "access");
const page = result?.page;
const seo = result?.seo;

const query = encodeURIComponent(COMPANY.mapQuery);
const embedUrl = `https://maps.google.com/maps?q=${query}&hl=ja&z=17&output=embed`;
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${query}`;
---

<Base
	title={seo?.title ?? "アクセス"}
	pageTitle={page?.data.title ?? "アクセス"}
	description={seo?.description}
	image={seo?.ogImage}
	canonical={seo?.canonical}
	robots={seo?.robots}
	content={page ? { collection: "pages", id: page.data.id, slug: page.id } : undefined}
>
	<PageHeader
		en={["Access"]}
		title={page?.data.title ?? "アクセス"}
		lead={page?.data.lead}
		titleEdit={page?.edit.title}
		leadEdit={page?.edit.lead}
		breadcrumb={[{ href: "/access", label: page?.data.title ?? "アクセス" }]}
	/>

	<section class="section container access">
		<div class="access__info">
			<Facts items={page?.data.facts} edit={page?.edit.facts} />
			{
				page?.data.content && page.data.content.length > 0 && (
					<div class="prose" {...page.edit.content}>
						<PortableText value={page.data.content} />
					</div>
				)
			}
			<div class="actions">
				<a href={mapUrl} class="btn btn--ghost" target="_blank" rel="noopener noreferrer">
					Googleマップで開く <Arrow direction="up-right" />
				</a>
			</div>
		</div>
		<div class="access__map">
			<iframe
				src={embedUrl}
				title={`${COMPANY.name}の地図`}
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"></iframe>
		</div>
	</section>
</Base>

<style>
	.access {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 48px 64px;
	}

	.access__info {
		display: grid;
		align-content: start;
		gap: 32px;
	}

	.access__map {
		min-height: 420px;
		border: 1px solid var(--color-hairline);
		border-radius: var(--radius-lg);
		overflow: hidden;
	}

	.access__map iframe {
		display: block;
		width: 100%;
		height: 100%;
		min-height: 420px;
		border: 0;
		/* Keep the map monochrome so it sits inside the gallery frame. */
		filter: grayscale(1) invert(0.92) contrast(0.9);
	}

	@media (max-width: 860px) {
		.access {
			grid-template-columns: 1fr;
		}
	}
</style>
