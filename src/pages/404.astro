---
import Arrow from "../components/Arrow.astro";
import StackTitle from "../components/StackTitle.astro";
import Base from "../layouts/Base.astro";

Astro.response.status = 404;
---

<Base title="ページが見つかりません" robots="noindex">
	<section class="container not-found">
		<p class="caption">Error 404</p>
		<StackTitle lines={["Not", "found."]} />
		<h1 class="heading">お探しのページが見つかりません</h1>
		<p class="lead">ページが移動または削除された可能性があります。</p>
		<div class="actions">
			<a href="/" class="btn">トップページへ <Arrow /></a>
		</div>
	</section>
</Base>

<style>
	.not-found {
		display: grid;
		gap: 24px;
		padding-block: clamp(96px, 16vw, 200px);
	}
</style>
